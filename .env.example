# ─── APPLICATION ───────────────────────────────────────────────
APP_NAME=TelegramAgent
APP_ENV=production
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this-in-production
API_KEY=your-api-key-for-rest-access

# ─── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/telegram_agent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─── REDIS ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1
REDIS_CACHE_TTL=3600

# ─── TELEGRAM API ──────────────────────────────────────────────
# نیازی به تغییر این مقادیر نیست — پیش‌فرض‌ها به صورت خودکار استفاده می‌شوند
# TELEGRAM_API_ID=2040
# TELEGRAM_API_HASH=b18441a1ff607e10a989891a5462e627

# ─── ADMIN BOT (BotFather bot token) ──────────────────────────
ADMIN_BOT_TOKEN=your_admin_bot_token
ADMIN_TELEGRAM_IDS=123456789,987654321
TELEGRAM_PUBLIC_BOT_TOKEN=your_public_challenge_bot_token
PUBLIC_BOT_USERNAME=your_public_challenge_bot_username

# ─── AI PROVIDER ───────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-3-mini
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# ─── GROQ DESKTOP IMAGE PLANNER ─────────────────────────────────
# Add the Groq API key in Replit Secrets (do not commit it to .env or git).
# Groq currently plans the Windows desktop scene; the final PNG is rendered
# locally from the project's real wallpaper and icon assets.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# ─── ANTI-SPAM ─────────────────────────────────────────────────
SPAM_MAX_MESSAGES_PER_MINUTE=5
SPAM_MAX_MESSAGES_PER_HOUR=30
SPAM_SCORE_THRESHOLD=0.8

# ─── MONITORING & ALERTS ───────────────────────────────────────
ALERT_CPU_THRESHOLD=85
ALERT_RAM_THRESHOLD=90
ALERT_DISK_THRESHOLD=90
HEALTH_CHECK_INTERVAL=60

# ─── CONTENT & PUBLISHING ─────────────────────────────────────
POST_DEFAULT_TIMEZONE=Asia/Tehran
MAX_CHANNELS_PER_POST=20
CONTENT_DEFAULT_LANGUAGES=en,fa
CONTENT_HASHTAGS_ENABLED=true
# Free RDP image: original Windows 10 wallpaper with a fresh 2–10 icon layout
# on every new post; the clock/date are refreshed too.
RDP_IMAGE_LAYOUT=fixed

# ─── CHALLENGES ────────────────────────────────────────────────
CHALLENGE_AUTO_ENABLED=true
CHALLENGE_INTERVAL_HOURS=10
CHALLENGE_DURATION_HOURS=48
CHALLENGE_DEFAULT_REWARD=Upgrade Team reward for the winning participants

# ─── SECURITY ─────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000

# ─── AI BEHAVIOR ──────────────────────────────────────────────
REPLY_TYPING_MIN_DELAY=0.5
REPLY_TYPING_MAX_DELAY=4.0
ENABLE_HUMANLIKE_DELAYS=true
AI_FACT_EXTRACTION_INTERVAL=10

# ─── SALES & LEADS ────────────────────────────────────────────
HOT_LEAD_SCORE_THRESHOLD=0.7
HOT_LEAD_ALERTS_ENABLED=true

# ─── FOLLOW-UP SEQUENCES ──────────────────────────────────────
FOLLOWUP_ENABLED=true
FOLLOWUP_STAGE1_HOURS=24
FOLLOWUP_STAGE2_HOURS=72
FOLLOWUP_STAGE3_HOURS=168

# ─── LEARNING & QUALITY ───────────────────────────────────────
LEARNING_AUTO_APPROVE_THRESHOLD=0.85
LEARNING_MIN_MESSAGES_FOR_SAMPLE=4

# ─── CRYPTO WALLET ADDRESSES ─────────────────────────────────────────
# Set these as secret environment variables in Render dashboard.
# Any wallet left empty will be hidden from customers automatically.
WALLET_BTC=bc1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WALLET_ETH=0xYourEthereumAddressHere
WALLET_USDT_TRC20=TYourTronUSDTAddressHere
WALLET_USDT_ERC20=0xYourERC20USDTAddressHere
WALLET_LTC=LYourLitecoinAddressHere
WALLET_BNB=0xYourBNBAddressHere
WALLET_TRX=TYourTRONAddressHere
